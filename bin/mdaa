#!/bin/bash
set -e
cwd=`pwd`
parent_path=$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd -P )
sh "$parent_path/../packages/cli/scripts/check_node_version.sh"
echo ""
echo "Running NPM Install for MDAA Repo"
cd "$parent_path/../"
npm install --no-save --quiet
echo ""
echo "Building MDAA CLI"
echo ""
export JSII_SILENCE_WARNING_UNTESTED_NODE_VERSION=1
# One-shot CLI build, so the nx daemon adds no value; disabling it also suppresses
# nx's interactive "Install Nx Console?" prompt.
MDAA_BUILD_CODE_ONLY=true NX_DAEMON=false npx nx run "@aws-mdaa/cli:build" --output-style=static
cd "$cwd"
echo ""
node "$parent_path/../packages/cli/lib/mdaa" $@
